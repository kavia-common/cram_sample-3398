{"is_source_file": true, "format": "Tcl (Tool Command Language) script", "description": "This file appears to be a script written to validate VLAN configurations on LAN ports using UCI commands and system utilities like ip and grep. It automates setting up VLANs, verifying their presence, and checking sub-interface configurations, primarily intended for network device validation or configuration testing.", "external_files": ["/etc/init.d/network"], "external_methods": ["uci", "ip", "grep", "sed", "sort"], "published": [], "classes": [], "methods": [], "calls": ["uci -q set network.vlan10='device'", "uci set network.vlan10.name='br-lan.10'", "uci set network.vlan10.type='8021q'", "uci set network.vlan10.ifname='br-lan'", "uci set network.vlan10.vid='10'", "uci -q commit network", "/etc/init.d/network reload", "uci show network", "grep -E 'network.vlan10'", "sed 's/@[0-9]\\+/@N/g'", "sort", "ip -o link show", "grep -E 'br-lan\\.10'", "sed -E 's/@.*>/:>/g;s/link\\/ether [0-9a-f:]+/link\\/ether XX:XX:XX:XX:XX:XX/g'", "cut -d' ' -f2-"], "search-terms": ["VLAN validation", "UCI network", "LAN port configuration", "VLAN VLAN10", "network reload", "LAN sub-interface", "Ethernet link show"], "state": 2, "file_id": 1, "knowledge_revision": 48, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "b0aa2b7956d86c80a2fc549fd70fe088", "format-version": 4, "code-base-name": "cram_sample-3398", "filename": "sample_case/11-lan-vlan-config.t", "revision_history": [{"48": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}