{"is_source_file": true, "format": "Shell script (bash)", "description": "This file contains shell script commands aimed at validating UCI (Unified Configuration Interface) set, commit, and reload cycles for wireless and network configurations on a device under test. It includes setting temporary configuration options, verifying applied values, and ensuring cleanup of temporary changes after testing.", "external_files": ["/etc/init.d/network"], "external_methods": ["uci set", "uci commit", "uci show", "/etc/init.d/network reload"], "published": ["R"], "classes": [], "methods": [], "calls": ["R \"uci set wireless.@wifi-iface[0].isolation='0'\"", "R \"uci commit wireless\"", "R \"/etc/init.d/network reload\"", "R \"uci show wireless\"", "R \"uci -q set network.globals='globals'\"", "R \"uci set network.globals.ula_prefix='fd00:dead:beef::/48'\"", "R \"uci commit network\"", "R \"/etc/init.d/network reload\"", "R \"uci show network.globals\""], "search-terms": ["UCI", "wireless", "network", "reload", "commit", "verify", "configuration"], "state": 2, "file_id": 12, "knowledge_revision": 60, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "513a4c021dde73ba092ba2f8ba283958", "format-version": 4, "code-base-name": "cram_sample-3398", "filename": "sample_case/16-uci-set-commit-reload.t", "revision_history": [{"60": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}