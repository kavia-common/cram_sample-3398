{"is_source_file": true, "format": "shell script", "description": "This file provides a test script to add an iptables LOG rule, verify kernel log entries, and then clean up the rule. It includes commands to insert iptables rules, generate test network traffic, and check logs for a specific prefix, primarily used for testing iptables logging functionality.", "external_files": ["logread", "dmesg"], "external_methods": ["logread", "dmesg"], "published": [], "classes": [], "methods": [], "calls": ["iptables -I INPUT 1 -p tcp --dport 65531 -j LOG --log-prefix \"${LP} \" --log-level 4", "nc -z -w1 127.0.0.1 65531", "logread", "dmesg", "grep -F \"${LP}\"", "tail -n 1", "sed 's/[[:space:]]\\+/ /g'", "iptables -D INPUT -p tcp --dport 65531 -j LOG --log-prefix \"${LP} \" --log-level 4"], "search-terms": ["iptables LOG rule", "kernel log verification", "test network traffic", "log prefix", "iptables cleanup"], "state": 2, "file_id": 3, "knowledge_revision": 46, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "1d54a33b9d8b8dec1baabd2bf25dd750", "format-version": 4, "code-base-name": "cram_sample-3398", "filename": "sample_case/23-iptables-logging.t", "revision_history": [{"46": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}